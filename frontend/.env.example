# Frontend environment variables
# Copy this file to .env.local and fill in real values — never commit .env.local

# URL of the FastAPI backend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Set to "false" to use the real backend (default is mock mode)
NEXT_PUBLIC_USE_MOCK_API=false

# WebSocket endpoint for live voice transcription (auto-derived from API_URL if not set)
# NEXT_PUBLIC_VOICE_WS_URL=ws://localhost:8000/voice/stream
