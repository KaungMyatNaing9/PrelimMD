# Frontend environment variables
# Copy this file to .env.local and fill in real values — never commit .env.local

# URL of the FastAPI backend (used by API helper in src/lib/api.ts)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Set to "false" to call the real FastAPI backend instead of using local mock data.
# Default (unset) uses mock mode so the UI works without a running backend.
NEXT_PUBLIC_USE_MOCK_API=false

# WebSocket endpoint for backend live transcription
NEXT_PUBLIC_VOICE_WS_URL=ws://localhost:8000/voice/stream

# TODO: Voice - ElevenLabs public key if called directly from browser
# NEXT_PUBLIC_ELEVENLABS_API_KEY=
