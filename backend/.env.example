# Backend environment variables
# Copy this file to .env and fill in real values — never commit .env

# ── AI ──────────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ── Voice (ElevenLabs — handles both STT and TTS) ───────────────────────────
ELEVENLABS_API_KEY=
# Optional: override Maya's voice (default is Aria — 9BWtsMINqrJLrRacOk9x)
# Other good nurse voices: Sarah=EXAVITQu4vr4xnSDxMaL, Laura=FGY2WhTYpPnrIDTdsKH5
# ELEVENLABS_VOICE_ID=9BWtsMINqrJLrRacOk9x

# ── App ─────────────────────────────────────────────────────────────────────
APP_ENV=development
LOG_LEVEL=info
